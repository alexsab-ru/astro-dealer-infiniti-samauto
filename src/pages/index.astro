---
import settings from '@/data/settings.json';
import Site from '@/components/PageTypes/Site.astro';
import SiteAlphaCenter from '@/components/PageTypes/SiteAlphaCenter.astro';
import SiteChinaSamaraAuto from '@/components/PageTypes/SiteChinaSamaraAuto.astro';
import Landing from '@/components/PageTypes/Landing.astro';
import LandingEVOLUTE from '@/components/PageTypes/LandingEVOLUTE.astro';
import LandingGAC from '@/components/PageTypes/LandingGAC.astro';
import LandingGEELY from '@/components/PageTypes/LandingGEELY.astro';
import LandingHAVAL from '@/components/PageTypes/LandingHAVAL.astro';
import LandingINFINITI from '@/components/PageTypes/LandingINFINITI.astro';
import ServiceKIA from '@/components/PageTypes/ServiceKIA.astro';

const SiteType = {
	LANDING: 'landing',
	LANDING_EVOLUTE: 'landing-evolute',
	LANDING_GAC: 'landing-gac',
	LANDING_GEELY: 'landing-geely',
	LANDING_HAVAL: 'landing-haval',
	LANDING_INFINITI: 'landing-infiniti',
	SITE: 'site',
	SITE_ALPHA_CENTER: 'site-alpha-center',
	SITE_CHINA_SAMARA_AUTO: 'site-china-samara-auto',
	SERVICE_KIA: 'service-kia'
};
const { siteType } = settings;
let Content: typeof Site | typeof Landing;

switch(siteType) {
	case SiteType.LANDING:
		Content = Landing;
		break;
	case SiteType.LANDING_EVOLUTE:
		Content = LandingEVOLUTE;
		break;
	case SiteType.LANDING_GAC:
		Content = LandingGAC;
		break;
	case SiteType.LANDING_GEELY:
		Content = LandingGEELY;
		break;
	case SiteType.LANDING_HAVAL:
		Content = LandingHAVAL;
		break;
	case SiteType.LANDING_INFINITI:
		Content = LandingINFINITI;
		break;
	case SiteType.SITE:
		Content = Site;
		break;
	case SiteType.SITE_ALPHA_CENTER:
		Content = SiteAlphaCenter;
		break;
	case SiteType.SITE_CHINA_SAMARA_AUTO:
		Content = SiteChinaSamaraAuto;
		break;
	case SiteType.SERVICE_KIA:
		Content = ServiceKIA;
		break;
	default:
		Content = Site;
}
---

<Layout title="INFINITI Самарские автомобили – официальный дилер INFINITI в городе Самара" description="INFINITI Самарские автомобили - официальный сервисный центр INFINITI в Самаре. Сервисное обслуживание INFINITI по выгодным ценам, оригинальные запчасти, постгарантийное обслуживание! Тел.: +7 (846) 993-66-00.">
	<Banner />
	{MARQUEE.show && <Morquee marquee={ MARQUEE } />}
	<section class="ptop-[2.7] pbottom-[2.5] bg-accent-500">
		<div class="container">
			<PageH1 h1=`Сервисный центр INFINITI в Самаре` classes="text-center fz-[3] text-white font-medium leading-none" />
		</div>
	</section>
	{TIMER.show && <Timer endtime={TIMER.endtime} title={TIMER.title} subtitle={TIMER.subtitle} btnName={TIMER.btnName} />}
	{specialServicesData && <SpecialServices items={specialServicesData} />}
	<LatestPosts collectionName="special-offers" title="Специальные предложения" id="specials" class="bg-gray-100" />
	<Services title="Услуги сервисного центра" />
	{servicesData && <NewServices items={servicesData} title="Услуги сервисного центра" id="new-services" show={false} />}
	{faqData && <Faq items={faqData} title="Часто задаваемые вопросы" class="bg-gray-100" />}
	<Callback bgUrl="https://cdn.alexsab.ru/b/infiniti/img/main-sliders/qx55.webp" />
	{reviewsData && <ReviewsSlider items={reviewsData} title="Отзывы о нас" class="bg-gray-100" />}
	<SeoText mdx="index" />
	<Contacts title="Наши контакты" />
</Layout>